# The corpus and the working store are the bulk of this project -- tens of
# gigabytes the image must never carry. The one database that ships is
# build/serving.db, the ~15MB facts-only store built by
# scripts/build_serving_store.py, excepted from the *.db rule below.
data/
*.db
*.sqlite3
!build/serving.db

.venv/
.git/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store

# Not part of the served app: ingestion runs from a workstation, not the host.
scripts/
tests/
docs/
*.md
